NODE_ENV=development
PORT=5000
DATABASE_PATH=server/data/tasks.db
CLIENT_ORIGIN=http://localhost:5000,http://localhost:5173
APP_BASE_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_INITIAL_PASSWORD=
DEMO_USERS_PASSWORD=
DEV_SEED_PASSWORD=FounderDev2026!
# Development-only persona switching; must be unset in production.
ENABLE_DEV_LOGIN=false
# Development-only simulation and acceptance tools; must be unset in production.
ENABLE_DEV_TOOLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Attachment upload settings
ATTACHMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ATTACHMENT_MAX_SIZE_MB=5