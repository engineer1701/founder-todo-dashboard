{
  "name": "founder-todo-dashboard",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Founder To-Do Allocation & Follow-Up Dashboard - Developer-Ready Product & Technical Specification",
  "main": "server/server.js",
  "scripts": {
    "server": "cross-env NODE_OPTIONS=--experimental-sqlite node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--experimental-sqlite node server/server.js",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--experimental-sqlite node server/server.js",
    "setup": "npm install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "test:at": "cross-env NODE_OPTIONS=--experimental-sqlite node server/tests/runAcceptanceTests.js",
    "test:email": "cross-env NODE_OPTIONS=--experimental-sqlite node server/scripts/testEmail.js",
    "add-test-employee": "cross-env NODE_OPTIONS=--experimental-sqlite node server/scripts/addTestEmployee.js",
    "set-password": "cross-env NODE_OPTIONS=--experimental-sqlite node server/scripts/setPassword.js"
  },
  "keywords": [
    "task-management",
    "founder-dashboard",
    "reminder-engine",
    "follow-up"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
